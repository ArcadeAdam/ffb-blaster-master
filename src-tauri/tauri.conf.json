{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFB Blaster MASTER",
  "version": "0.2.0-beta.16",
  "identifier": "com.arcade.ffbblaster.master",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FFB Blaster MASTER — Beta 16",
        "width": 1320,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
